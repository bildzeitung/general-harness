# medplum.env — Local-dev environment variables for the Medplum Docker Compose stack.
# These are non-production defaults safe for local integration testing.
# Do NOT use these credentials in production.
#
# Consumed by: docker-compose.yml (via --env-file flag)
# Read by:     medplum-agent.md to write infra/medplum/connection.json

# Server port (exposed on localhost)
MEDPLUM_PORT=8103

# PostgreSQL connection
MEDPLUM_DATABASE_HOST=medplum-postgres
MEDPLUM_DATABASE_PORT=5432
MEDPLUM_DATABASE_NAME=medplum
MEDPLUM_DATABASE_USERNAME=medplum
MEDPLUM_DATABASE_PASSWORD=medplum_local_dev_password

# Medplum client credentials (used by test agents to authenticate against the FHIR API)
MEDPLUM_CLIENT_ID=local-integration-client
MEDPLUM_CLIENT_SECRET=local-integration-secret-changeme
