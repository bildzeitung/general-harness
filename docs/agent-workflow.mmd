flowchart TD
    controller([controller])

    subgraph planning [Planning]
        planner[planner]
        debater_epic[debater\nepic review]
        planner_rev[planner\nrevision pass]
    end

    subgraph implementation [Implementation]
        coding[coding-agent]
        testing[testing-agent]
        merge[merge-agent]
    end

    subgraph utility [Data / Utility]
        synthea[synthea-agent]
        medplum[medplum-agent]
        python[python-project-creator]
        code_review[code-review-agent]
        documenter[documenter]
    end

    done([✓ done])

    controller -->|epic / needs-planning| planner
    controller -->|P0/P1 bug or needs-planning bug| debater_bug[debater\nbug triage]
    controller -->|bug P2-P4 / task| coding
    controller -->|test data task| synthea
    controller -->|medplum task| medplum
    controller -->|python project| python
    controller -->|review task| code_review
    controller -->|docs task| documenter

    planner -->|first pass| debater_epic
    debater_epic -->|criticisms| planner_rev
    planner_rev -.->|subtasks → bd ready| coding

    debater_bug --> coding

    coding --> testing
    testing -->|pass| merge
    testing -->|fail| coding
    merge --> done

    synthea --> done
    medplum --> done
    python --> done
    code_review --> done
    documenter --> done

    classDef orchestrator fill:#3b82f6,stroke:#1d4ed8,color:white
    classDef planning     fill:#16a34a,stroke:#14532d,color:white
    classDef impl         fill:#f97316,stroke:#c2410c,color:white
    classDef ops          fill:#0d9488,stroke:#0f766e,color:white
    classDef utility      fill:#9333ea,stroke:#6b21a8,color:white
    classDef terminal     fill:#1f2937,stroke:#111827,color:white

    class controller orchestrator
    class planner,debater_epic,planner_rev,debater_bug planning
    class coding impl
    class testing,merge ops
    class synthea,medplum,python,code_review,documenter utility
    class done terminal
